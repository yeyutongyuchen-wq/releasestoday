---
export const prerender = true;

import Layout from '../../components/Layout.astro';
import { loadGamesFromD1, type Game } from '../../lib/load-games';

export async function getStaticPaths() {
  const games = await loadGamesFromD1();
  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

interface Props {
  game: Game;
}

const { game } = Astro.props;

const TRAILERS: Record<string, string> = {
  'grand-theft-auto-vi': 'QdBZY2fkU-0',
  'eclipse-protocol': '8shA4k_q6s4',
  'night-circuit': 'K_03kFqWfqs',
};

const youtubeId = (game.youtube_id && game.youtube_id !== TRAILERS['grand-theft-auto-vi'] || game.slug === 'grand-theft-auto-vi')
  ? (game.youtube_id || TRAILERS[game.slug] || '')
  : (TRAILERS[game.slug] || game.youtube_id || '');

const trailerId = TRAILERS[game.slug] || game.youtube_id || '';

const statusClass =
  game.status === 'Released' || game.status === 'Locked'
    ? 'border-emerald-400/40 bg-emerald-400/10 text-emerald-300'
    : game.status === 'Delayed'
      ? 'border-amber-400/40 bg-amber-400/10 text-amber-300'
      : 'border-neutral-600 bg-neutral-800 text-neutral-300';

const dateLabel = game.release_date
  ? new Date(`${game.release_date}T00:00:00Z`).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })
  : 'Date TBA';

const recVramMatch = game.specs_rec.gpu.match(/(\d+)\s*GB/i);
const recVram = recVramMatch ? recVramMatch[1] : '12';

const notifyCopy =
  game.status === 'Released'
    ? { title: 'Never miss an update', sub: 'Get DLC windows and historic low-price alerts for this title.', cta: 'Track Game' }
    : game.status === 'TBA' || game.status === 'Rumored'
      ? { title: 'Be the first to know the official date', sub: 'One email when the calendar lock drops. No digest list.', cta: 'Get Lock Notice' }
      : { title: 'Notify me when this game launches or gets delayed', sub: 'One email when the date moves or the game goes live.', cta: 'Notify Me' };
---

<Layout title={`${game.title} Release Date & Countdown`} description={`${game.title} release date, trailer, delay history, and PC system requirements.`}>
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
    <div class="min-w-0 space-y-10 lg:col-span-8">
      <header class="space-y-5 border-b border-cyan-500/20 pb-8">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-cyan-400">Release tracker</p>
        <h1 class="text-4xl font-black tracking-tight text-white sm:text-5xl">{game.title} Release Date & Countdown</h1>
        <div class="flex flex-wrap items-end gap-4">
          <time class="text-4xl font-black tabular-nums text-cyan-300" datetime={game.release_date || undefined} data-date={game.release_date}>{dateLabel}</time>
          <span class:list={['rounded-full border px-3 py-1 text-sm font-semibold', statusClass]}>{game.status}</span>
        </div>
        <p id="countdown" class="font-mono text-sm text-neutral-400">{game.release_date ? 'Calculating countdown…' : 'Official date not locked.'}</p>
        <ul class="flex flex-wrap gap-2">
          {game.platforms.map((platform) => (
            <li class="rounded-full border border-fuchsia-400/30 bg-fuchsia-500/10 px-3 py-1 text-xs font-semibold uppercase text-fuchsia-200">{platform}</li>
          ))}
        </ul>
        {game.cover_url && (
          <figure class="max-w-xs overflow-hidden rounded-2xl border border-blue-400/40 shadow-[0_0_15px_rgba(59,130,246,0.5)]">
            <img src={game.cover_url} alt={`${game.title} cover art`} class="aspect-[3/4] w-full object-cover" width="280" height="373" />
          </figure>
        )}
      </header>

      {game.delay_history.length > 0 && (
        <section class="space-y-6">
          <h2 class="text-2xl font-bold text-white">Release Date & Delay History</h2>
          <ol class="relative ml-3 space-y-6 border-l border-dashed border-cyan-400/40 pl-8">
            {game.delay_history.map((event) => (
              <li class="relative">
                <span class="absolute -left-[2.4rem] top-1.5 h-3 w-3 rounded-full border-2 border-neutral-950 bg-cyan-400 shadow-[0_0_12px_rgba(34,211,238,0.8)]" />
                <p class="font-mono text-xs uppercase tracking-widest text-cyan-300">{event.date}</p>
                <p class="mt-1 font-semibold text-white">{event.type}</p>
                {event.reason && <p class="mt-1 text-sm text-neutral-400">{event.reason}</p>}
              </li>
            ))}
          </ol>
        </section>
      )}

      {trailerId && (
        <section class="space-y-4">
          <h2 class="text-2xl font-bold text-white">Official Announcement Trailer</h2>
          <div class="overflow-hidden rounded-2xl border border-cyan-400/30 bg-neutral-950">
            <div class="relative aspect-video">
              <iframe
                class="absolute inset-0 h-full w-full"
                src={`https://www.youtube-nocookie.com/embed/${trailerId}`}
                title={`${game.title} trailer`}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
          </div>
        </section>
      )}

      <section class="space-y-6" data-game-page data-slug={game.slug} data-rec-vram={recVram}>
        <h2 class="text-2xl font-bold text-white">Can My PC Run {game.title}? System Requirements</h2>
        <div class="grid gap-4 md:grid-cols-2">
          <article class="rounded-2xl border border-neutral-800 bg-neutral-900/70 p-5">
            <h3 class="text-sm font-semibold uppercase tracking-widest text-neutral-400">Minimum</h3>
            <dl class="mt-4 space-y-3 text-sm">
              <div><dt class="text-neutral-500">CPU</dt><dd>{game.specs_min.cpu}</dd></div>
              <div><dt class="text-neutral-500">RAM</dt><dd>{game.specs_min.ram}</dd></div>
              <div><dt class="text-neutral-500">Storage</dt><dd>{game.specs_min.storage}</dd></div>
              <div><dt class="text-neutral-500">GPU</dt><dd>{game.specs_min.gpu}</dd></div>
            </dl>
          </article>
          <article class="rounded-2xl border border-cyan-400/20 bg-neutral-900/70 p-5">
            <h3 class="text-sm font-semibold uppercase tracking-widest text-cyan-300">Recommended</h3>
            <dl class="mt-4 space-y-3 text-sm">
              <div><dt class="text-neutral-500">CPU</dt><dd>{game.specs_rec.cpu}</dd></div>
              <div><dt class="text-neutral-500">RAM</dt><dd>{game.specs_rec.ram}</dd></div>
              <div><dt class="text-neutral-500">Storage</dt><dd>{game.specs_rec.storage}</dd></div>
              <div><dt class="text-neutral-500">GPU</dt><dd class="font-semibold text-cyan-200">{game.specs_rec.gpu}</dd></div>
            </dl>
          </article>
        </div>
        <div class="ad-slot hidden" data-ad-format="horizontal" aria-hidden="true"></div>
        <aside id="hw-panel" class="rounded-2xl border border-neutral-700 bg-neutral-900/80 p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-400">AI Hardware Analyzer</p>
          <p id="hw-status" class="mt-3 text-sm text-neutral-200">Scanning local GPU and VRAM tier…</p>
          <div id="hw-manual" hidden class="mt-4">
            <label for="gpu-select" class="block text-xs uppercase tracking-widest text-neutral-500">Select your GPU series</label>
            <select id="gpu-select" class="mt-2 w-full rounded-lg border border-neutral-700 bg-neutral-950 px-3 py-2 text-sm text-white">
              <option value="">Choose a series</option>
              <option value="16">RTX 4070 Ti / 16GB class</option>
              <option value="12">RTX 4070 / 12GB class</option>
              <option value="8">RTX 3060 Ti / 8GB class</option>
              <option value="6">GTX 1660 / 6GB class</option>
              <option value="0">Intel Integrated</option>
            </select>
          </div>
        </aside>
        <aside id="amazon-banner" hidden class="mt-4 rounded-2xl border border-amber-400/40 bg-neutral-950/90 p-5">
          <h3 class="text-base font-bold text-amber-100">Ready for an upgrade? Explore {recVram}GB cards that meet this recommended tier on Amazon.</h3>
          <a href={`https://www.amazon.com/s?k=${encodeURIComponent(recVram + 'GB graphics card')}`} rel="nofollow sponsored noopener noreferrer" target="_blank" class="mt-4 inline-flex rounded-lg bg-amber-400 px-4 py-2 text-sm font-bold text-neutral-950">View {recVram}GB GPU Deals on Amazon →</a>
        </aside>
      </section>
    </div>

    <aside class="space-y-4 lg:col-span-4 lg:sticky lg:top-6 lg:self-start">
      {(game.affiliate_links?.humble || game.affiliate_links?.gmg) && (
        <section class="rounded-2xl border border-cyan-400/20 bg-neutral-900/70 p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-400">Official stores</p>
          <div class="mt-3 grid gap-2">
            {game.affiliate_links?.humble && <a href={game.affiliate_links.humble} rel="sponsored noopener noreferrer" target="_blank" class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm font-semibold text-white">Humble Store ↗</a>}
            {game.affiliate_links?.gmg && <a href={game.affiliate_links.gmg} rel="sponsored noopener noreferrer" target="_blank" class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm font-semibold text-white">GreenManGaming ↗</a>}
          </div>
        </section>
      )}
      <section class="rounded-2xl border border-cyan-400/20 bg-neutral-900/70 p-5">
        <h2 class="text-lg font-bold text-white">{notifyCopy.title}</h2>
        <p class="mt-2 text-sm text-neutral-400">{notifyCopy.sub}</p>
        <form id="subscribe-form" class="mt-4 space-y-3">
          <label class="sr-only" for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@email.com" class="w-full rounded-lg border border-neutral-700 bg-neutral-950/80 px-4 py-3 text-sm text-white outline-none focus:border-cyan-400" />
          <button type="submit" class="w-full rounded-lg bg-cyan-400 px-5 py-3 text-sm font-bold text-neutral-950">{notifyCopy.cta}</button>
        </form>
        <p id="subscribe-status" class="mt-3 hidden text-sm" role="status"></p>
        <p class="mt-3 text-[12px] leading-5 text-neutral-500">Get an email notice for delays or launch. Unsubscribe anytime in accordance with our Privacy Policy.</p>
      </section>
    </aside>
  </div>

  <script is:inline>
    (function () {
      const page = document.querySelector('[data-game-page]');
      const countdownEl = document.getElementById('countdown');
      const dateEl = document.querySelector('[data-date]');
      const form = document.getElementById('subscribe-form');
      const statusEl = document.getElementById('subscribe-status');
      const hwPanel = document.getElementById('hw-panel');
      const hwStatus = document.getElementById('hw-status');
      const hwManual = document.getElementById('hw-manual');
      const gpuSelect = document.getElementById('gpu-select');
      const banner = document.getElementById('amazon-banner');
      const slug = page ? page.getAttribute('data-slug') || '' : '';
      const recVram = Number(page ? page.getAttribute('data-rec-vram') || '12' : '12');

      document.querySelectorAll('.ad-slot').forEach((slot) => {
        if (!(slot.getAttribute('data-ad-client') || window.adsbygoogle)) slot.style.display = 'none';
      });

      if (countdownEl && dateEl) {
        const raw = dateEl.getAttribute('data-date') || '';
        if (!raw) countdownEl.textContent = 'Official date not locked.';
        else {
          const target = Date.parse(raw + 'T00:00:00Z');
          const pad = (n) => String(n).padStart(2, '0');
          const tick = () => {
            const diff = target - Date.now();
            if (diff <= 0) { countdownEl.textContent = 'Already Released'; return; }
            const s = Math.floor(diff / 1000);
            countdownEl.textContent = Math.floor(s / 86400) + 'd ' + pad(Math.floor((s % 86400) / 3600)) + 'h ' + pad(Math.floor((s % 3600) / 60)) + 'm ' + pad(s % 60) + 's';
          };
          tick();
          setInterval(tick, 1000);
        }
      }

      if (form && statusEl) {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const emailInput = form.querySelector('#email');
          const email = emailInput && 'value' in emailInput ? String(emailInput.value).trim() : '';
          statusEl.classList.remove('hidden');
          statusEl.textContent = 'Sending…';
          try {
            const res = await fetch('/api/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, game_id: slug }) });
            const data = await res.json().catch(() => ({}));
            const passed = res.ok && (data.ok === true || data.success === true);
            statusEl.textContent = passed ? 'You are on the list.' : data.error || 'Could not save.';
            if (passed) form.reset();
          } catch { statusEl.textContent = 'Network error.'; }
        });
      }

      const vramMap = [
        { token: '4090', gb: 24 }, { token: '4080', gb: 16 }, { token: '4070 ti', gb: 16 },
        { token: '4070', gb: 12 }, { token: '4060 ti', gb: 8 }, { token: '4060', gb: 8 },
        { token: '3090', gb: 24 }, { token: '3080', gb: 10 }, { token: '3070', gb: 8 },
        { token: '3060', gb: 12 }, { token: '2080', gb: 8 }, { token: '2070', gb: 8 },
        { token: '2060', gb: 6 }, { token: '1660', gb: 6 }, { token: '1650', gb: 4 },
        { token: '1060', gb: 6 }, { token: '1050', gb: 2 }, { token: '7800', gb: 16 },
        { token: '7700', gb: 12 }, { token: '7600', gb: 8 }, { token: '6800', gb: 16 },
        { token: '6700', gb: 12 }, { token: '6600', gb: 8 }, { token: 'uhd', gb: 0 },
        { token: 'iris', gb: 0 }, { token: 'intel', gb: 0 }, { token: 'radeon graphics', gb: 0 },
        { token: 'mali', gb: 0 }, { token: 'adreno', gb: 0 }
      ];

      const probeWebGL = () => {
        const out = { model: '', maxTexture: 0, maxRenderbuffer: 0 };
        try {
          const canvas = document.createElement('canvas');
          const gl = canvas.getContext('webgl2') || canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
          if (!gl) return out;
          const ext = gl.getExtension('WEBGL_debug_renderer_info');
          if (ext) {
            const raw = String(gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) || '');
            if (raw && raw.toLowerCase() !== 'generic renderer') out.model = raw;
          }
          if (!out.model) out.model = String(gl.getParameter(gl.RENDERER) || '');
          out.maxTexture = Number(gl.getParameter(gl.MAX_TEXTURE_SIZE)) || 0;
          out.maxRenderbuffer = Number(gl.getParameter(gl.MAX_RENDERBUFFER_SIZE)) || 0;
        } catch (_) {}
        return out;
      };

      const vramFromModel = (label) => {
        if (!label) return null;
        const hay = label.toLowerCase();
        const hit = vramMap.find((row) => hay.includes(row.token));
        return hit ? hit.gb : null;
      };

      const vramFromLimits = (maxTexture, maxRenderbuffer) => {
        const size = Math.max(maxTexture || 0, maxRenderbuffer || 0);
        if (size >= 32768) return 12;
        if (size >= 16384) return 6;
        if (size >= 8192) return 2;
        if (size >= 4096) return 1;
        if (size > 0) return 0;
        return null;
      };

      const applyResult = (model, gb, limits) => {
        if (!hwPanel || !hwStatus) return;
        const limitNote = limits.maxTexture
          ? ' WebGL max texture ' + limits.maxTexture + 'px / renderbuffer ' + limits.maxRenderbuffer + 'px.'
          : '';
        if (!model && gb === null) {
          hwStatus.textContent = 'Hardware Scan: Browser blocked GPU readout. Choose your series below.';
          if (hwManual) hwManual.hidden = false;
          if (banner) banner.hidden = true;
          return;
        }
        if (hwManual) hwManual.hidden = true;
        const shown = model || 'Unknown GPU';
        const vram = gb === null ? 0 : gb;
        if (vram >= recVram) {
          hwPanel.classList.add('border-emerald-400/40');
          hwStatus.textContent = 'Hardware Scan: ' + shown + ' · estimated ~' + vram + 'GB VRAM. Meets the recommended ' + recVram + 'GB tier.' + limitNote;
          if (banner) banner.hidden = true;
        } else {
          hwPanel.classList.add('border-amber-400/40');
          hwStatus.textContent = 'Hardware Scan: ' + shown + ' · estimated ~' + vram + 'GB VRAM. Below the recommended ' + recVram + 'GB tier.' + limitNote;
          if (banner) banner.hidden = false;
        }
      };

      const probe = probeWebGL();
      const modelGb = vramFromModel(probe.model);
      const limitGb = vramFromLimits(probe.maxTexture, probe.maxRenderbuffer);
      applyResult(probe.model, modelGb !== null ? modelGb : limitGb, probe);

      if (gpuSelect) {
        gpuSelect.addEventListener('change', () => {
          if (!gpuSelect.value) return;
          applyResult(gpuSelect.options[gpuSelect.selectedIndex].text, Number(gpuSelect.value) || 0, probe);
        });
      }
    })();
  </script>
</Layout>
