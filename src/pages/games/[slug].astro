---
export const prerender = true;

import Layout from '../../components/Layout.astro';

type DelayEvent = {
  date: string;
  type: string;
  reason?: string;
};

type Specs = {
  cpu: string;
  ram: string;
  storage: string;
  gpu: string;
};

type Game = {
  title: string;
  slug: string;
  release_date: string;
  platforms: string[];
  status: 'Locked' | 'Delayed';
  delay_history: DelayEvent[];
  specs_min: Specs;
  specs_rec: Specs;
  cover_url: string;
  youtube_id: string;
};

export function getStaticPaths() {
  const games: Game[] = [
    {
      title: 'Grand Theft Auto VI',
      slug: 'grand-theft-auto-vi',
      release_date: '2026-11-20',
      platforms: ['PS5', 'Xbox Series X'],
      status: 'Delayed',
      delay_history: [
        { date: '2023-12', type: 'First Announcement' },
        { date: '2025-05', type: 'Window Confirmed', reason: 'Fall 2025 target' },
        { date: '2026-05', type: 'Delayed', reason: 'Polishing' },
        { date: '2026-11-20', type: 'Locked Window' },
      ],
      specs_min: {
        cpu: 'Intel Core i7-10700K / AMD Ryzen 7 3700X',
        ram: '16 GB',
        storage: '150 GB SSD',
        gpu: 'NVIDIA GeForce RTX 3060 / AMD Radeon RX 6600 XT',
      },
      specs_rec: {
        cpu: 'Intel Core i7-12700K / AMD Ryzen 7 5800X3D',
        ram: '32 GB',
        storage: '150 GB NVMe SSD',
        gpu: 'NVIDIA GeForce RTX 3070 / AMD Radeon RX 6700 XT',
      },
      cover_url: 'https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1200&q=80',
      youtube_id: 'QdBZY2fkU-0',
    },
    {
      title: 'Eclipse Protocol',
      slug: 'eclipse-protocol',
      release_date: '2026-09-18',
      platforms: ['PC', 'PS5', 'Xbox Series X'],
      status: 'Locked',
      delay_history: [
        { date: '2025-03', type: 'First Announcement' },
        { date: '2026-01', type: 'Date Locked', reason: 'Production complete' },
      ],
      specs_min: {
        cpu: 'Intel Core i5-10400 / AMD Ryzen 5 3600',
        ram: '16 GB',
        storage: '80 GB SSD',
        gpu: 'NVIDIA GeForce GTX 1660 Super / AMD Radeon RX 5600 XT',
      },
      specs_rec: {
        cpu: 'Intel Core i7-12700 / AMD Ryzen 7 5700X',
        ram: '16 GB',
        storage: '80 GB NVMe SSD',
        gpu: 'NVIDIA GeForce RTX 3070 / AMD Radeon RX 6700 XT',
      },
      cover_url: 'https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=1200&q=80',
      youtube_id: 'QdBZY2fkU-0',
    },
  ];

  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

interface Props {
  game: Game;
}

const { game } = Astro.props;
const statusClass =
  game.status === 'Locked'
    ? 'border-emerald-400/40 bg-emerald-400/10 text-emerald-300'
    : 'border-amber-400/40 bg-amber-400/10 text-amber-300';

const dateLabel = new Date(`${game.release_date}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Layout
  title={`${game.title} Release Date & Countdown`}
  description={`${game.title} release date, trailer, delay history, and PC system requirements.`}
>
  <article
    class="space-y-12"
    data-game-page
    data-slug={game.slug}
    data-date={game.release_date}
    data-rec-gpu={game.specs_rec.gpu}
  >
    <header class="grid items-start gap-8 border-b border-cyan-500/20 pb-10 lg:grid-cols-[280px_minmax(0,1fr)]">
      <figure class="overflow-hidden rounded-2xl border border-blue-400/40 shadow-[0_0_15px_rgba(59,130,246,0.5)]">
        <img src={game.cover_url} alt={`${game.title} cover art`} class="aspect-[3/4] w-full object-cover" width="280" height="373" />
      </figure>
      <div class="space-y-5">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-cyan-400">Release tracker</p>
        <h1 class="text-4xl font-black tracking-tight text-white sm:text-5xl">
          {game.title} Release Date & Countdown
        </h1>
        <div class="flex flex-wrap items-end gap-4">
          <time class="text-4xl font-black tabular-nums text-cyan-300" datetime={game.release_date} data-date={game.release_date}>
            {dateLabel}
          </time>
          <span class:list={['rounded-full border px-3 py-1 text-sm font-semibold', statusClass]}>{game.status}</span>
        </div>
        <p id="countdown" class="font-mono text-sm text-neutral-400">Calculating countdown…</p>
        <ul class="flex flex-wrap gap-2">
          {game.platforms.map((platform) => (
            <li class="rounded-full border border-fuchsia-400/30 bg-fuchsia-500/10 px-3 py-1 text-xs font-semibold uppercase text-fuchsia-200">
              {platform}
            </li>
          ))}
        </ul>
        <section class="rounded-2xl border border-cyan-400/20 bg-neutral-900/70 p-5 backdrop-blur">
          <h2 class="text-lg font-bold text-white">Notify me when this game launches or gets delayed</h2>
          <form id="subscribe-form" class="mt-4 flex flex-col gap-3 sm:flex-row">
            <label class="sr-only" for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@email.com" class="w-full rounded-lg border border-neutral-700 bg-neutral-950/80 px-4 py-3 text-sm text-white outline-none focus:border-cyan-400" />
            <button type="submit" class="rounded-lg bg-cyan-400 px-5 py-3 text-sm font-bold text-neutral-950 hover:bg-cyan-300">Notify Me</button>
          </form>
          <p id="subscribe-status" class="mt-3 hidden text-sm" role="status"></p>
          <p class="mt-3 text-[12px] leading-5 text-neutral-500">
            Get an email notice for delays or launch. Unsubscribe anytime in accordance with our Privacy Policy.
          </p>
        </section>
      </div>
    </header>

    {game.delay_history.length > 0 && (
      <section class="space-y-6">
        <h2 class="text-2xl font-bold text-white">Release Date & Delay History</h2>
        <ol class="relative ml-3 space-y-6 border-l border-dashed border-cyan-400/40 pl-8">
          {game.delay_history.map((event) => (
            <li class="relative">
              <span class="absolute -left-[2.4rem] top-1.5 h-3 w-3 rounded-full border-2 border-neutral-950 bg-cyan-400 shadow-[0_0_12px_rgba(34,211,238,0.8)]" />
              <p class="font-mono text-xs uppercase tracking-widest text-cyan-300">{event.date}</p>
              <p class="mt-1 font-semibold text-white">{event.type}</p>
              {event.reason && <p class="mt-1 text-sm text-neutral-400">{event.reason}</p>}
            </li>
          ))}
        </ol>
      </section>
    )}

    {game.youtube_id && (
      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-white">Official Announcement Trailer</h2>
        <div class="overflow-hidden rounded-2xl border border-cyan-400/30 bg-neutral-950 shadow-[0_0_30px_rgba(34,211,238,0.18)]">
          <div class="relative aspect-video">
            <iframe
              class="absolute inset-0 h-full w-full"
              src={`https://www.youtube-nocookie.com/embed/${game.youtube_id}`}
              title={`${game.title} official announcement trailer`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
        </div>
      </section>
    )}

    <section class="space-y-6">
      <h2 class="text-2xl font-bold text-white">Can My PC Run {game.title}? System Requirements</h2>
      <p class="text-sm text-neutral-400">
        CPU, RAM, and storage are listed for manual comparison. Browsers cannot reliably read those values. GPU is scanned locally in this tab only.
      </p>
      <div class="grid gap-4 md:grid-cols-2">
        <article class="rounded-2xl border border-neutral-800 bg-neutral-900/70 p-5">
          <h3 class="text-sm font-semibold uppercase tracking-widest text-neutral-400">Minimum</h3>
          <dl class="mt-4 space-y-3 text-sm">
            <div><dt class="text-neutral-500">CPU</dt><dd class="text-neutral-100">{game.specs_min.cpu}</dd></div>
            <div><dt class="text-neutral-500">RAM</dt><dd class="text-neutral-100">{game.specs_min.ram}</dd></div>
            <div><dt class="text-neutral-500">Storage</dt><dd class="text-neutral-100">{game.specs_min.storage}</dd></div>
            <div><dt class="text-neutral-500">GPU</dt><dd class="text-neutral-100">{game.specs_min.gpu}</dd></div>
          </dl>
        </article>
        <article class="rounded-2xl border border-cyan-400/20 bg-neutral-900/70 p-5">
          <h3 class="text-sm font-semibold uppercase tracking-widest text-cyan-300">Recommended</h3>
          <dl class="mt-4 space-y-3 text-sm">
            <div><dt class="text-neutral-500">CPU</dt><dd class="text-neutral-100">{game.specs_rec.cpu}</dd></div>
            <div><dt class="text-neutral-500">RAM</dt><dd class="text-neutral-100">{game.specs_rec.ram}</dd></div>
            <div><dt class="text-neutral-500">Storage</dt><dd class="text-neutral-100">{game.specs_rec.storage}</dd></div>
            <div><dt class="text-neutral-500">GPU</dt><dd class="text-neutral-100">{game.specs_rec.gpu}</dd></div>
          </dl>
        </article>
      </div>

      <aside id="hw-panel" class="rounded-2xl border border-neutral-700 bg-neutral-900/80 p-5 backdrop-blur">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-400">AI Hardware Analyzer</p>
        <p id="hw-status" class="mt-3 text-sm text-neutral-200">Scanning local GPU…</p>
        <div id="hw-manual" hidden class="mt-4 space-y-2">
          <label for="gpu-select" class="block text-xs uppercase tracking-widest text-neutral-500">Select your GPU series</label>
          <select id="gpu-select" class="w-full rounded-lg border border-neutral-700 bg-neutral-950 px-3 py-2 text-sm text-white">
            <option value="">Choose a series</option>
            <option value="pass">RTX 40 Series</option>
            <option value="pass">RTX 30 Series</option>
            <option value="pass">RX 7000 Series</option>
            <option value="pass">RX 6000 Series</option>
            <option value="fail">GTX 16 Series</option>
            <option value="fail">GTX 10 Series</option>
            <option value="fail">RX 500 Series</option>
            <option value="fail">Intel Integrated</option>
          </select>
        </div>
      </aside>

      <aside id="amazon-banner" hidden class="translate-y-2 rounded-2xl border border-amber-400/30 bg-amber-400/10 p-5 opacity-0 transition duration-300">
        <p class="font-semibold text-amber-200">Your GPU might struggle. Check upgraded GPUs on Amazon.</p>
        <a
          href="https://www.amazon.com/s?k=graphics+card"
          rel="nofollow sponsored noopener noreferrer"
          target="_blank"
          class="mt-3 inline-block text-sm font-semibold text-amber-100 underline decoration-amber-400/50 underline-offset-4"
        >
          Browse current GPU listings
        </a>
      </aside>
    </section>
  </article>

  <script is:inline>
    (function () {
      const page = document.querySelector('[data-game-page]');
      const countdownEl = document.getElementById('countdown');
      const dateEl = document.querySelector('[data-date]');
      const form = document.getElementById('subscribe-form');
      const statusEl = document.getElementById('subscribe-status');
      const hwPanel = document.getElementById('hw-panel');
      const hwStatus = document.getElementById('hw-status');
      const hwManual = document.getElementById('hw-manual');
      const gpuSelect = document.getElementById('gpu-select');
      const banner = document.getElementById('amazon-banner');
      const slug = page ? page.getAttribute('data-slug') || '' : '';

      const passTokens = ['4060', '4070', '4080', '4090', '3070', '3080', '3090', '4070', '6750', '6800', '6900', '7600', '7700', '7800', '7900'];
      const failTokens = ['1060', '1050', '1650', '1660', '1030', '580', '570', '550', 'intel', 'uhd', 'iris', 'vega 8', '620', 'mx'];
      const genericTokens = ['microsoft', 'basic render', 'generic', 'llvmpipe', 'swiftshader', 'gdi generic'];

      if (countdownEl && dateEl) {
        const raw = dateEl.getAttribute('data-date') || dateEl.getAttribute('datetime') || '';
        const target = Date.parse(raw.length === 10 ? raw + 'T00:00:00Z' : raw);
        const pad = (n) => String(n).padStart(2, '0');
        const tick = () => {
          if (!Number.isFinite(target)) {
            countdownEl.textContent = 'Release date unavailable.';
            return;
          }
          const diff = target - Date.now();
          if (diff <= 0) {
            countdownEl.textContent = 'Already Released';
            return;
          }
          const totalSeconds = Math.floor(diff / 1000);
          countdownEl.textContent =
            Math.floor(totalSeconds / 86400) + 'd ' +
            pad(Math.floor((totalSeconds % 86400) / 3600)) + 'h ' +
            pad(Math.floor((totalSeconds % 3600) / 60)) + 'm ' +
            pad(totalSeconds % 60) + 's';
        };
        tick();
        setInterval(tick, 1000);
      }

      if (form && statusEl) {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const emailInput = form.querySelector('#email');
          const email = emailInput && 'value' in emailInput ? String(emailInput.value).trim() : '';
          statusEl.classList.remove('hidden', 'text-emerald-400', 'text-rose-400');
          statusEl.textContent = 'Sending…';
          try {
            const res = await fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email, game_id: slug }),
            });
            const data = await res.json().catch(() => ({}));
            const passed = res.ok && (data.ok === true || data.success === true);
            statusEl.classList.add(passed ? 'text-emerald-400' : 'text-rose-400');
            statusEl.textContent = passed
              ? 'You are on the list. Watch for delay or launch mail.'
              : data.error || 'Could not save this subscription.';
            if (passed) form.reset();
          } catch {
            statusEl.classList.add('text-rose-400');
            statusEl.textContent = 'Network error. Try again.';
          }
        });
      }

      const detectGpu = () => {
        try {
          const canvas = document.createElement('canvas');
          const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
          if (!gl) return '';
          const ext = gl.getExtension('WEBGL_debug_renderer_info');
          if (!ext) return '';
          return String(gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) || '');
        } catch {
          return '';
        }
      };

      const showBanner = (on) => {
        if (!banner) return;
        if (on) {
          banner.hidden = false;
          requestAnimationFrame(() => {
            banner.classList.remove('opacity-0', 'translate-y-2');
            banner.classList.add('opacity-100', 'translate-y-0');
          });
        } else {
          banner.classList.add('opacity-0', 'translate-y-2');
          banner.classList.remove('opacity-100', 'translate-y-0');
          banner.hidden = true;
        }
      };

      const applyResult = (label, verdict) => {
        if (!hwPanel || !hwStatus) return;
        hwPanel.classList.remove('border-emerald-400/40', 'border-amber-400/40', 'border-neutral-700');
        if (verdict === 'pass') {
          hwPanel.classList.add('border-emerald-400/40');
          hwStatus.textContent =
            '✨ Hardware Scan: Your ' + label + ' is fully capable of running this game at Recommended settings. Enjoy!';
          showBanner(false);
        } else if (verdict === 'fail') {
          hwPanel.classList.add('border-amber-400/40');
          hwStatus.textContent =
            '⚠️ Hardware Scan: Your ' + label + ' might struggle to deliver smooth frame rates. Consider a graphics upgrade for the best experience.';
          showBanner(true);
        } else {
          hwPanel.classList.add('border-neutral-700');
          hwStatus.textContent =
            'Hardware Scan: GPU model could not be confirmed (' + (label || 'generic display adapter') + '). Choose your series below.';
          if (hwManual) hwManual.hidden = false;
          showBanner(false);
        }
      };

      const classify = (raw) => {
        const hay = raw.toLowerCase();
        if (!raw || genericTokens.some((token) => hay.includes(token))) return 'unknown';
        if (passTokens.some((token) => hay.includes(token))) return 'pass';
        if (failTokens.some((token) => hay.includes(token))) return 'fail';
        return 'unknown';
      };

      const gpu = detectGpu();
      applyResult(gpu || 'undetected adapter', classify(gpu));

      if (gpuSelect) {
        gpuSelect.addEventListener('change', () => {
          const value = gpuSelect.value;
          const label = gpuSelect.options[gpuSelect.selectedIndex].text;
          if (value === 'pass') applyResult(label, 'pass');
          if (value === 'fail') applyResult(label, 'fail');
        });
      }
    })();
  </script>
</Layout>
